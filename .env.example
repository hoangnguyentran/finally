# FinAlly environment variables.
# Copy to .env at the project root and fill in your keys:  cp .env.example .env
# .env is gitignored; the start scripts and docker-compose read it.

# Required: OpenRouter API key, used for the AI chat assistant.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (E2E tests,
# CI, or local development without an OpenRouter key).
LLM_MOCK=false
